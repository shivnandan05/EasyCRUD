pipeline {
    agent {
        label 'worker'
    }
    tools{
        maven 'mvn'
    }
     environment {
        my_aws_cred = credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'main', url:'https://github.com/shivnandan05/EasyCRUD.git'
            }
        }
        stage('build'){
            steps{
                dir('backend'){
                 sh'mvn clean package'
                }
            }
            post{
            success{
                archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
            }
        }
        }
        stage('Artifacts to s3'){
            steps{
                sh '''
                 sudo snap install aws-cli --classic
                 aws s3 cp backend/target/*.jar s3://amnz-shiva-bucket/Artifact/student.jar

                '''
            }
        }
        stage('SonarQube Analysis'){
            steps{
                dir('backend'){
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
            }
        }
        stage('Quality Gate'){
            steps{
                timeout(time:5, unit: TimeUnit.MINUTE){
                waitForQualityGate() abortOnTimeout: true 
                }
            }
        }
    }
}
