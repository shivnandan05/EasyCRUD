pipeline {
    agent {
        label 'worker'
    }
    tools{
        maven 'mvn'
    }
     environment {
        my_aws_cred = credentials('aws-cred')
        ECR_REPO = '871346884083.dkr.ecr.ap-south-1.amazonaws.com/backend'
    }
    stages{
        stage('checkout'){
            steps{
                git branch: 'main', url:'https://github.com/shivnandan05/EasyCRUD.git'
            }
        }
        stage('build'){
            steps{
                dir('backend'){
                 sh'mvn clean package'
                }
            }
            post{
            success{
                archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
            }
        }
        }
        stage('Artifacts to s3'){
            steps{
                sh '''
                 sudo snap install aws-cli --classic
                 aws s3 cp backend/target/*.jar s3://amnz-shiva-bucket/Artifact/student.jar

                '''
            }
        }
        stage('SonarQube Analysis'){
            steps{
                dir('backend'){
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
            }
        }
      stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t backend:${BUILD_NUMBER} .
                        docker images
                    '''
                }
            }
        }
         stage('Push To ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 871346884083.dkr.ecr.ap-south-1.amazonaws.com
                    docker tag backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }
    }   
}
